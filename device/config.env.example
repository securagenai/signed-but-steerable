# Copy to device/config.env and adjust. Sourced by every device script (bash) and read by the Python
# scripts through environment variables.
export PRIOR_DIR="$HOME/edge_rag_experiment"                  # previous study: llama.cpp build + GGUF models
export LLAMA_SERVER="$PRIOR_DIR/llama.cpp/build/bin/llama-server"
export MODEL_3B="$PRIOR_DIR/models/qwen2.5-3b-instruct-q4_k_m.gguf"
export LLM_THREADS=4
export REPRO=1                                                # pinned models only (see pins.json)
