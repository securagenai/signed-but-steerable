# Copy to remote/pi.env. Used by the desktop helpers below (Linux or WSL2 with ssh + rsync).
# Key-based SSH login is assumed (the same access used for the prior study / VS Code Remote-SSH).
PI_HOST=raspberrypi.local
PI_USER=pi
PI_DIR=/home/pi/signed-but-steerable
SSH_OPTS="-o ServerAliveInterval=30 -o ServerAliveCountMax=6"
